APP_ENV=development
MYSQL_ROOT_PASSWORD=development-root-password
MYSQL_PASSWORD=development-seckill-password
GRAFANA_ADMIN_PASSWORD=development-grafana-password
SECKILL_LOCK_MODE=redis_lua_only
LOCAL_LIMIT_RATE=1000
LOCAL_LIMIT_BURST=1000
REDIS_LIMIT_GLOBAL_RATE=500
REDIS_LIMIT_GLOBAL_BURST=500
REDIS_LIMIT_PRODUCT_RATE=200
REDIS_LIMIT_PRODUCT_BURST=200
REDIS_LIMIT_USER_RATE=5
REDIS_LIMIT_USER_BURST=5
KAFKA_ORDER_TOPIC=seckill.order-created.v1
KAFKA_CONSUMER_GROUP=seckill-order-consumer
KAFKA_CONSUMER_POLL_RECORDS=1
ORDER_ID_NODE_ID=1
# Disabled by default. It only exposes the cancellation endpoint when
# APP_ENV=development; it is not a replacement for production authentication.
ORDER_CANCEL_API_ENABLED=false
INVENTORY_RELEASE_POLL_INTERVAL=250ms
INVENTORY_RELEASE_LEASE=30s
RESERVATION_OUTBOX_CONSUMER_GROUP=seckill-reservation-outbox
# Optional. Leave unset when running multiple publishers so hostname-derived
# consumer names are unique.
# RESERVATION_OUTBOX_CONSUMER_NAME=outbox-publisher-1
RESERVATION_OUTBOX_CLAIM_IDLE=30s
RESERVATION_OUTBOX_POLL_INTERVAL=200ms
RESERVATION_OUTBOX_BATCH_SIZE=100
